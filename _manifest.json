{
  "manifest_version": 2,
  "id": "chunian.maibot-plugin-douyin-surf",
  "version": "1.2.1",
  "name": "抖音冲浪与分享",
  "description": "浏览已登录抖音推荐流和综合搜索，按可配置规则筛选并定时分享内容的 MaiBot 插件。",
  "author": {
    "name": "chunian",
    "url": "https://github.com/mailchunian8395-arch"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/mailchunian8395-arch/maibot-plugin-douyin-surf",
    "documentation": "https://github.com/mailchunian8395-arch/maibot-plugin-douyin-surf#readme",
    "homepage": "https://github.com/mailchunian8395-arch/maibot-plugin-douyin-surf",
    "issues": "https://github.com/mailchunian8395-arch/maibot-plugin-douyin-surf/issues"
  },
  "host_application": {
    "min_version": "0.5.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "playwright",
      "version_spec": ">=1.40.0"
    },
    {
      "type": "python_package",
      "name": "yt-dlp",
      "version_spec": ">=2026.8.19"
    },
    {
      "type": "python_package",
      "name": "trafilatura",
      "version_spec": ">=2.1.0"
    },
    {
      "type": "python_package",
      "name": "openai",
      "version_spec": ">=1.95.0"
    }
  ],
  "capabilities": [
    "chat.get_all_streams",
    "message.get_by_time_in_chat",
    "llm.generate",
    "llm.get_available_models",
    "api.call",
    "maisaka.proactive.trigger",
    "send.text",
    "send.image",
    "send.hybrid"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
